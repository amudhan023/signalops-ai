# Image versions — bump freely, these are known-good pins.
OPENSEARCH_VERSION=2.18.0
KAFKA_VERSION=3.9.0
OTELCOL_VERSION=0.160.0
PROMETHEUS_VERSION=v3.1.0
ALERTMANAGER_VERSION=v0.27.0
GRAFANA_VERSION=11.4.0
POSTGRES_VERSION=pg17
REDIS_VERSION=7-alpine

# OpenSearch JVM heap. 1g is enough for a demo corpus.
# Raise to 2g if you index more than a few days of logs.
OPENSEARCH_HEAP=-Xms1g -Xmx1g

# Kafka JVM heap. Default is 1g; 512m is plenty for one broker.
KAFKA_HEAP=-Xmx512m -Xms512m

POSTGRES_USER=srecopilot
POSTGRES_PASSWORD=changeme-local-dev-only
POSTGRES_DB=srecopilot

# Where your app processes listen on the host. Used by Prometheus (scrape)
# and Alertmanager (webhook). Nothing in this stack runs them.
SIMULATOR_PORT=8000
RECEIVER_PORT=8080
